# privacy_analytics configuration -- copy to .env and edit. Never commit .env.
# Everything here is read from the process environment (twelve-factor).

# --- identity ---------------------------------------------------------------
APP_ENV=development
# Required when APP_ENV=production; the app refuses to start without it.
SECRET_KEY=change-me-in-production

# --- HTTP -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
MAX_CONTENT_LENGTH=8388608

# --- storage ----------------------------------------------------------------
# Leave empty to use the bundled sqlite database under var/instance.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/privacy_analytics
DATA_DIR=
INSTANCE_DIR=
LOG_DIR=

# --- observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
REQUEST_ID_HEADER=X-Request-ID

# --- application-specific ---------------------------------------------------
# Salt for the visitor hash. Changing it separates every visitor from their
# history, because the hash is derived from it.
ANALYTICS_SALT=change-me-in-production
# Base URL the CLI talks to; also accepted as --url.
ANALYTICS_URL=http://127.0.0.1:8000
